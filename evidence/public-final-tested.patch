+import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs';import os from 'node:os';import path from 'node:path';
+import {checkedCheckpoint,checkedSegmentResult,acquireLock,integer} from '../src/chain-progress.ts';import {digest,atomic} from '../src/integrity.ts';
+const base=()=>({binding:'binding',sourceDigest:'source',status:'PARTIAL',totalSlots:10419,totalPages:51567,slots:8,pages:0,rpcThisInvocation:100});
+test('resume binds source and fixed set; rejects damaged, fractional, negative, out-of-range and reordered cursors',()=>{const d=fs.mkdtempSync(path.join(os.tmpdir(),'droso-progress-')),f=d+'/p.json';const put=(p:any)=>atomic(f,{...p,localDigest:digest(p)});try{put(base());assert.equal(checkedCheckpoint(f,'binding','source').slots,8);assert.throws(()=>checkedCheckpoint(f,'wrong','source'));assert.throws(()=>checkedCheckpoint(f,'binding','wrong'));
+for(const patch of [{slots:1.5},{slots:-1},{slots:10420},{pages:1},{pages:51568},{slots:NaN},{status:'FAILED'}]){put({...base(),...patch});assert.throws(()=>checkedCheckpoint(f,'binding','source'));}put(base());assert.throws(()=>checkedCheckpoint(f,'binding','source',{slots:16,pages:0}));const p=JSON.parse(fs.readFileSync(f,'utf8'));p.slots=16;fs.writeFileSync(f,JSON.stringify(p));assert.throws(()=>checkedCheckpoint(f,'binding','source'),/RESUME_CHANGED/);}finally{fs.rmSync(d,{recursive:true});}});
+test('segment cannot fake full, rollback, exceed RPC reservation or change source',()=>{const check=(p:any)=>checkedSegmentResult({...p,localDigest:digest(p)},{slots:8,pages:0},'binding','source',128);assert.equal(check(base()).slots,8);for(const patch of [{status:'PASS_FULL'},{slots:0},{rpcThisInvocation:129},{sourceDigest:'other'}])assert.throws(()=>check({...base(),...patch}));assert.equal(check({...base(),status:'PASS_FULL',slots:10419,pages:51567}).status,'PASS_FULL');});
+test('exclusive process lock cannot be stolen; release allows next invocation',()=>{const d=fs.mkdtempSync(path.join(os.tmpdir(),'droso-lock-'));try{const release=acquireLock(d+'/run.lock');assert.throws(()=>acquireLock(d+'/run.lock'));release();acquireLock(d+'/run.lock')();}finally{fs.rmSync(d,{recursive:true});}});
+test('bounded configuration rejects NaN, huge, fractional or zero concurrency',()=>{for(const n of [NaN,Infinity,17,0,1.5])assert.throws(()=>integer(n,16,'LIMIT',1));});
